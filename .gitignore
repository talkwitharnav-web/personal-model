.venv/
__pycache__/
*.pyc

checkpoints/
# Every data/<name>/ folder only ever holds regenerated output (train.txt,
# validation.bin, train_ids.npy, etc.) - the .py scripts directly in data/
# (not inside a subfolder) are the real source of truth and stay tracked.
data/*/
tokenizer/tokenizer.json

*.pt
*.pth
*.bin
*.safetensors
*.npy
*.index

# RAG index build output - regenerated by rag/build_index.py, not source
rag/wikipedia_passages.txt
# The 2026-08-20 rebuild wrote a second passage file under a new name, which the line above
# did not cover - 16 GB sitting untracked and ready to be swept in by `git add .`.
rag/wikipedia_clean_passages.txt
rag/build_state*.json

.vscode/